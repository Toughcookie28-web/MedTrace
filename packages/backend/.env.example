# PharmaLedger Backend Configuration
# Copy this file to .env and update with your values

# ==========================================
# Server Configuration
# ==========================================
PORT=3001
HOST=localhost
NODE_ENV=development
CORS_ORIGIN=http://localhost:5174

# ==========================================
# Network Selection
# ==========================================
# Options: localhost, sepolia, polygonAmoy, polygon
NETWORK=localhost

# ==========================================
# Localhost Network (Hardhat)
# ==========================================
LOCALHOST_RPC_URL=http://127.0.0.1:8545
LOCALHOST_STAKEHOLDER_REGISTRY=0x5FbDB2315678afecb367f032d93F642f64180aa3
LOCALHOST_DIGITAL_BATCH=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
LOCALHOST_TRACK_AND_TRACE=0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9
LOCALHOST_SUPPLY_CHAIN_EVENTS=0x5FC8d32690cc91D4c39d9d3abcBD16989F875707
LOCALHOST_PARTNERSHIP_REGISTRY=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
LOCALHOST_AUTHORIZED_SHIPPER_REGISTRY=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9

# ==========================================
# Sepolia Testnet
# ==========================================
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
SEPOLIA_STAKEHOLDER_REGISTRY=
SEPOLIA_DIGITAL_BATCH=
SEPOLIA_TRACK_AND_TRACE=

# ==========================================
# Polygon Amoy Testnet
# ==========================================
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_AMOY_STAKEHOLDER_REGISTRY=
POLYGON_AMOY_DIGITAL_BATCH=
POLYGON_AMOY_TRACK_AND_TRACE=

# ==========================================
# Polygon Mainnet (Production)
# ==========================================
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_STAKEHOLDER_REGISTRY=
POLYGON_DIGITAL_BATCH=
POLYGON_TRACK_AND_TRACE=

# ==========================================
# Event Indexer Configuration
# ==========================================
INDEXER_ENABLED=true
INDEXER_POLLING_INTERVAL=5000
INDEXER_BATCH_SIZE=100
INDEXER_START_BLOCK=0

# ==========================================
# API Configuration
# ==========================================
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=20
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# ==========================================
# Cache Configuration (Future)
# ==========================================
CACHE_ENABLED=false
CACHE_TTL=300
